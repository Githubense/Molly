  m_Name: DialogueTable_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 5f513252a17ec4252af117a324618232, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2847601373527933232
  m_TableData:
  - m_Id: 94198816768
    m_Localized: Troppo morbido, troppo avvolgente... non voglio alzarmi.
    m_Metadata:
      m_Items: []
  - m_Id: 1399371877834752
    m_Localized: Impostazioni
    m_Metadata:
      m_Items:
      - rid: 2847601373527933232
  - m_Id: 1402210666668032
    m_Localized: Lingue
    m_Metadata:
      m_Items: []
  - m_Id: 1402345610010624
    m_Localized: Inizia
    m_Metadata:
      m_Items: []
  - m_Id: 1402420016963584
    m_Localized: Esci
    m_Metadata:
      m_Items: []
  - m_Id: 1409510345269248
    m_Localized: Chiudi
    m_Metadata:
      m_Items: []
  - m_Id: 1771908071677952
    m_Localized: Ti ho lasciato senza cibo di nuovo... mi dispiace.
    m_Metadata:
      m_Items: []
  - m_Id: 1773525143642112
    m_Localized: ' Integratori di ferro, vitamine... li prendo, ma aiutano davvero?'
    m_Metadata:
      m_Items: []
  - m_Id: 1774559781969920
    m_Localized: Solo acqua. Perfetto.
    m_Metadata:
      m_Items: []
  - m_Id: 1774736135675904
    m_Localized: Dovrei dipingere. Ma non riesco nemmeno a pensare.
    m_Metadata:
      m_Items: []
  - m_Id: 1774976356048896
    m_Localized: "Non ascolto pi\xF9 musica... Era troppo confortante."
    m_Metadata:
      m_Items: []
  - m_Id: 1775080999739392
    m_Localized: " L'acqua calda a volte mi fa sentire pi\xF9 leggera."
    m_Metadata:
      m_Items: []
  - m_Id: 1775455676915712
    m_Localized: Troppi piatti da lavare. Forse domani.
    m_Metadata:
      m_Items: []
  - m_Id: 1775821172760576
    m_Localized: A volte mi chiedo... se il mio corpo potesse rifiutare tutto, forse
      mi sentirei meglio.
    m_Metadata:
      m_Items: []
  references:
    version: 2
